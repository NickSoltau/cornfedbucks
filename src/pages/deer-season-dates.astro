---
import Layout from '../layouts/Layout.astro';
import { seasonDateStates } from '../data/seasonDateStates';
---
<Layout
  title="Deer Season Dates by State: 2026-27 Corn Belt Guide"
  description="Find 2026-27 deer season dates for Ohio, Michigan, Indiana, Illinois, Iowa, Minnesota, and Wisconsin — archery, gun, muzzleloader, and bag limits, state by state."
>
  <section class="hub">
    <div class="wrap hub__inner">
      <p class="eyebrow">Season Dates</p>
      <h1>Deer Season Dates by State: 2026-27</h1>
      <p class="hub__intro">
        Pick your state for archery, gun, and muzzleloader dates, license costs, and rifle rules.
        Each page is refreshed in place when the state agency publishes new dates. For license
        costs and deadlines side by side, see the
        <a href="/blog/deer-hunting-license-guide-seven-state/">7-state license guide</a>.
      </p>

      <ul class="hub__list">
        {seasonDateStates.map((state) => (
          <li>
            <a class="hub__card" href={state.href}>
              <h2 class="hub__card-title">{state.name} Deer Season Dates</h2>
              <p class="hub__card-desc">{state.blurb}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .hub { padding: 3rem 0 5rem; }
  .hub__inner { max-width: 720px; }
  .hub h1 {
    font-size: clamp(2rem, 4vw, 2.6rem);
    margin: 0.4rem 0 0.9rem;
  }
  .hub__intro {
    opacity: 0.85;
    line-height: 1.55;
    margin: 0 0 2rem;
  }
  .hub__intro a { color: var(--blaze); }
  .hub__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .hub__card {
    display: block;
    text-decoration: none;
    color: var(--ink);
    background: var(--frost);
    border: 2px solid var(--stalk);
    border-radius: 3px;
    padding: 1.1rem 1.4rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .hub__card:hover {
    border-color: var(--blaze);
    transform: translateY(-2px);
  }
  .hub__card-title {
    font-size: 1.2rem;
    margin: 0 0 0.35rem;
  }
  .hub__card-desc {
    font-size: 0.92rem;
    opacity: 0.8;
    margin: 0;
  }
</style>
