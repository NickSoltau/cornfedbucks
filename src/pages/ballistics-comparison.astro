---
import Layout from '../layouts/Layout.astro';
import FaqSchema from '../components/FaqSchema.astro';
import dataset from '../../public/data/ballistics-dataset.json';

const cartridgeCount = Object.keys(dataset).length;
const loadCount = Object.values(dataset).reduce((n, c) => n + c.loads.length, 0);

// Same SWC classification the picker uses (public/scripts/ballistics-comparison.js).
const swcSet = new Set(['.350 Legend', '.400 Legend', '.450 Bushmaster', '.360 Buckhammer', '.45-70 Govt']);
const rows = Object.entries(dataset)
  .map(([name, c]) => ({
    name,
    type: swcSet.has(name) ? 'SWC' : 'Shouldered',
    e100: c.generic['100'].energy,
    e200: c.generic['200'].energy,
    e300: c.generic['300'].energy,
    d200: -c.generic['200'].trajectory,
    d300: -c.generic['300'].trajectory,
  }))
  .sort((a, b) => b.e100 - a.e100);

const faqItems = [
  { question: "What does a 100-yard zero mean on this tool?", answer: "It means every load is shown as if the rifle is sighted in to hit the point of aim at 100 yards. The bullet is below your line of sight past that and slightly above it before that. We convert tables published at other zeros so the lines can be compared." },
  { question: "What does a dashed line mean?", answer: "A dashed segment is calculated, not copied from a manufacturer table. Some are converted to a 100-yard zero from a table published at a different zero. Others are filled in between published yardages or estimated from published velocity." },
  { question: "Why are some loads greyed out?", answer: "No manufacturer table or ammo.com table exists for them that we could find. We show them greyed out instead of guessing numbers." },
  { question: "Where does the data come from?", answer: "From manufacturers' published ballistics tables, plus ammo.com's published tables for loads whose makers don't publish their own. Those are marked via ammo.com in the load list. The data was sourced in September 2026." },
];
---
<Layout
  title="Straight-Wall vs Shouldered Ballistics Tool"
  description="Compare energy, trajectory, and velocity across straight-wall and shouldered deer cartridges, up to four loads at once — built around the 200-yard wall."
>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.js" is:inline></script>

  <section class="ballistics">
    <div class="wrap">
      <header class="ballistics__header">
        <p class="eyebrow">Cornfed Bucks — Ballistics Lab</p>
        <h1>Ballistics Comparison Tool</h1>
        <p class="ballistics__intro">
          Pick up to four loads — any mix of straight-wall and shouldered cartridges — and see how
          they actually fly. Built around the 200-yard wall: most ag-field shots never get past 150.
        </p>
        <p class="ballistics__intro ballistics__intro--summary">
          This tool compares energy, trajectory and velocity out to 300 yards for {cartridgeCount} cartridges and {loadCount} loads, from straight-wall rounds like the .350 Legend to shouldered rounds like the .308 Winchester. Everything is standardized to a 100-yard zero and 50-yard steps. Want to know how the data was built? Read <a href="/blog/straight-wall-vs-shouldered-ballistics-comparison/">Straight-Wall vs Shouldered Ballistics</a>.
        </p>
        <p class="ballistics__updated">Data sourced Sept. 2026 · Last updated: October 1, 2026</p>
        <div class="disclaimer">
          <b>Heads up:</b> manufacturers don't all measure trajectory the same way — some zero at 100
          yards, some at 200, and the yardage steps don't line up either. We standardized everything to
          a 100-yard zero and 50-yard steps, which means some figures here are calculated, not copied
          straight off the box (marked with a dashed line). Some makers, mostly Winchester, don't publish
          ballistics tables for their popular deer loads, so for those we use ammo.com's published
          tables (marked "via ammo.com" in the list). A few loads have no published numbers anywhere,
          so they're greyed out below rather than faked.
        </div>
      </header>

      <div class="layout">
        <div class="picker">
          <h2>Select loads</h2>
          <div class="slot-count" id="slotCount">0 / 4 selected</div>
          <div id="groups"></div>
        </div>

        <div id="heroSlot"></div>

        <div class="sidestack" id="sideSlot"></div>
      </div>

      <section class="ballistics__glance">
        <h2>Ballistics at a Glance: Generic Figures, 100-Yard Zero</h2>
        <p class="ballistics__glance-note">
          These are generic figures — the average of the loads for each cartridge — so individual
          loads vary. Ranked by energy at 100&nbsp;yd, highest first.
        </p>
        <div class="ballistics__table-scroll">
          <table class="ballistics__table">
            <thead>
              <tr>
                <th scope="col">Cartridge</th>
                <th scope="col">Type</th>
                <th scope="col">Energy at 100 yd (ft-lbs)</th>
                <th scope="col">Energy at 200 yd</th>
                <th scope="col">Energy at 300 yd</th>
                <th scope="col">Drop at 200 yd (in)</th>
                <th scope="col">Drop at 300 yd (in)</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row">{r.name}</th>
                  <td>{r.type}</td>
                  <td>{Math.round(r.e100)}</td>
                  <td>{Math.round(r.e200)}</td>
                  <td>{Math.round(r.e300)}</td>
                  <td>{r.d200.toFixed(1)}</td>
                  <td>{r.d300.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="ballistics__faq">
        <h2>FAQ: Ballistics Comparison</h2>
        {faqItems.map((qa) => (
          <p><strong>{qa.question}</strong><br />{qa.answer}</p>
        ))}
        <FaqSchema items={faqItems} />
      </section>

      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "CornfedBucks Ballistics Comparison Tool",
        url: "https://cornfedbucks.com/ballistics-comparison/",
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Any",
        isAccessibleForFree: true,
        dateModified: "2026-10-01",
        inLanguage: "en-US",
        author: { "@type": "Person", name: "Nick" },
        isPartOf: { "@type": "WebSite", name: "CornfedBucks", url: "https://cornfedbucks.com/" }
      })} />

      <footer class="ballistics__footer">
        Click any small chart on the right to swap it into the main view. Loads/legend are ranked by
        descending energy at 100&nbsp;yd (highest-hitting load listed first). Data: manufacturer-published
        ballistics tables, plus ammo.com's published tables for loads whose makers don't publish their
        own (marked &ldquo;via ammo.com&rdquo;), sourced Sept 2026. Dashed segments are calculated. Some are
        converted to a 100-yd zero from a table published at a different zero, or filled in between
        published yardages; those stay close to the published numbers. Others use a trajectory
        estimated from published velocity data (no manufacturer BC available), and points past
        200&nbsp;yd for those loads are rough estimates, accurate to roughly &plusmn;20&ndash;35% versus a
        true published figure. Wind drift intentionally excluded — too situational to generalize.
      </footer>
    </div>
  </section>

  <script src="/scripts/ballistics-comparison.js" is:inline></script>
</Layout>

<style is:global>
  :root {
    --ballistics-line-a: var(--blaze);
    --ballistics-line-b: var(--dusk);
    --ballistics-line-c: #8a6d3a;
    --ballistics-line-d: var(--stalk);
    --ballistics-border: var(--stalk);
    --ballistics-surface: #ffffff;
    --ballistics-text: var(--ink);
    --ballistics-text-dim: var(--stalk);
  }
</style>

<style>
  .ballistics {
    padding: 3rem 0 4rem;
  }
  .ballistics__header { margin-bottom: 1.75rem; }
  .ballistics__header h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 0.4rem 0 0.9rem;
  }
  .ballistics__intro {
    color: var(--ink);
    opacity: 0.85;
    max-width: 66ch;
    line-height: 1.55;
    margin: 0;
  }

  .ballistics__intro--summary { margin-top: 0.75rem; }
  .ballistics__updated {
    font-size: 0.82rem;
    color: var(--stalk);
    margin: 0.6rem 0 0;
  }

  .disclaimer {
    background: #f4e3c8;
    border: 1px solid var(--husk);
    border-radius: 6px;
    padding: 0.9rem 1.1rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink);
    margin-top: 1.1rem;
  }
  .disclaimer b { color: var(--blaze); }

  .layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 320px;
    gap: 1.1rem;
    align-items: start;
  }
  @media (max-width: 1150px) {
    .layout { grid-template-columns: 240px minmax(0, 1fr); }
    :global(.sidestack) { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .layout { grid-template-columns: 1fr; }
    :global(.sidestack) { grid-column: auto; }
  }

  /* Below 1150px, #heroSlot/.sidestack no longer get a JS-set pixel height
     (see syncHeights() in ballistics-comparison.js), so the flex:1 / min-height:0
     sizing that fills a fixed-height parent on desktop collapses charts to 0px
     tall. Give chart holders a real fixed height instead. */
  @media (max-width: 1150px) {
    :global(#heroSlot .chartcard),
    :global(.sidestack .sidecard),
    :global(.sidestack .sidecard.pos0),
    :global(.sidestack .sidecard.pos1) {
      flex: none;
      min-height: auto;
    }
    :global(#heroSlot .chart-holder) {
      flex: none;
      height: 320px;
      min-height: 320px;
    }
    :global(.sidestack .chart-holder) {
      flex: none;
      height: 240px;
      min-height: 240px;
    }
    /* Without JS-driven heights below 1150px, the picker's natural height
       (15 collapsible cartridges) is often much taller than the chart next
       to it. align-items:start (above) stops that from stretching the chart
       cell, but the picker itself still needs a cap + internal scroll or it
       just pushes the page very long before the chart is reachable. */
    :global(.picker) {
      max-height: 60vh;
      overflow-y: auto;
    }
  }

  :global(.chart-holder) { position: relative; }

  /* Short / landscape-phone viewports (e.g. a phone rotated sideways) have
     very little vertical room — often under 430px total. Compact the header
     copy and chart heights so the actual tool is reachable without several
     screens of scrolling. Desktop and normal portrait-phone heights are
     untouched. */
  @media (max-height: 500px) {
    .ballistics { padding: 0.85rem 0 1.5rem; }
    .ballistics__header { margin-bottom: 0.85rem; }
    .ballistics__header .eyebrow { display: none; }
    .ballistics__header h1 {
      font-size: 1.3rem;
      margin: 0 0 0.4rem;
    }
    .ballistics__intro { display: none; }
    .disclaimer {
      padding: 0.5rem 0.7rem;
      font-size: 0.72rem;
      margin-top: 0.6rem;
    }
    :global(.picker) { max-height: 44vh; }
    :global(#heroSlot .chart-holder) { height: 200px; min-height: 200px; }
    :global(.sidestack .chart-holder) { height: 140px; min-height: 140px; }
  }

  :global(.picker) {
    background: #fff;
    border: 1px solid var(--stalk);
    border-radius: 8px;
    padding: 1rem;
    position: sticky;
    top: 1rem;
    overflow-y: auto;
  }
  /* Below 760px, .layout collapses to a single column (picker, hero chart,
     and sidestack all stacked in normal flow) — sticky then pins the picker
     to the top of the viewport while the charts scroll up underneath it,
     overlapping. Sticky only makes sense next to a taller side-by-side
     column, so drop it once the layout stops being side-by-side. */
  @media (max-width: 760px) {
    :global(.picker) { position: static; }
  }
  :global(#heroSlot) { display: flex; flex-direction: column; }
  :global(#heroSlot .chartcard) { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  :global(.picker h2) {
    font-size: 0.82rem;
    font-family: var(--font-tag);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--stalk);
    margin: 0 0 0.1rem;
  }
  :global(.slot-count) {
    font-family: var(--font-tag);
    font-size: 0.75rem;
    color: var(--blaze);
    margin-bottom: 0.75rem;
  }
  :global(.group) { margin-bottom: 0.4rem; border-bottom: 1px solid var(--husk); }
  :global(.group summary) {
    cursor: pointer;
    padding: 0.6rem 0.25rem;
    font-weight: 600;
    font-size: 0.92rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
  }
  :global(.group summary::-webkit-details-marker) { display: none; }
  :global(.group summary::after) { content: "+"; color: var(--stalk); font-weight: 400; }
  :global(.group[open] summary::after) { content: "\2013"; }
  :global(.group .cat) {
    font-size: 0.65rem;
    font-family: var(--font-tag);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--stalk);
    font-weight: 500;
  }
  :global(.loadlist) { padding: 0 0.15rem 0.6rem; display: flex; flex-direction: column; gap: 0.15rem; }
  :global(.loadrow) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: 5px;
    font-size: 0.82rem;
    cursor: pointer;
    line-height: 1.3;
  }
  :global(.loadrow:hover) { background: var(--frost); }
  :global(.loadrow input) { margin-top: 0.2rem; accent-color: var(--blaze); }
  :global(.loadrow .name) { color: var(--ink); }
  :global(.loadrow .meta) { color: var(--stalk); font-size: 0.72rem; }
  :global(.loadrow.disabled) { opacity: 0.55; cursor: not-allowed; }
  :global(.loadrow.disabled .name) { text-decoration: line-through; color: var(--stalk); }
  :global(.loadrow.disabled:hover) { background: none; }
  :global(.loadrow.maxed:not(.checked)) { opacity: 0.4; cursor: not-allowed; }

  :global(.chartcard) {
    background: #fff;
    border: 1px solid var(--stalk);
    border-radius: 8px;
    padding: 1.1rem 1.1rem 0.75rem;
  }
  :global(.chartcard h3) {
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
  }
  :global(.chartcard .unit) {
    font-family: var(--font-tag);
    font-size: 0.72rem;
    color: var(--stalk);
    font-weight: 400;
  }

  :global(#heroSlot .chart-holder) { flex: 1; min-height: 280px; margin-top: 0.75rem; }
  :global(#heroSlot h3) { font-size: 1.15rem; }

  :global(.sidestack) { display: flex; flex-direction: column; gap: 0.9rem; }
  :global(.sidestack .chart-holder) { margin-top: 0.5rem; flex: 1; min-height: 130px; }
  :global(.sidestack .sidecard) {
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  :global(.sidestack .sidecard:hover) { border-color: var(--blaze); }
  :global(.sidestack .sidecard:hover .swap-hint) { opacity: 1; }
  :global(.sidestack .sidecard.pos0) { flex: 1.4; }
  :global(.sidestack .sidecard.pos0 h3) { font-size: 1.02rem; }
  :global(.sidestack .sidecard.pos1) { flex: 1; }
  :global(.sidestack h3) { font-size: 0.85rem; }
  :global(.sidestack .rank) {
    font-family: var(--font-tag);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.62rem;
    color: var(--blaze);
    font-weight: 600;
  }
  :global(.swap-hint) {
    margin-left: auto;
    font-size: 0.65rem;
    color: var(--stalk);
    opacity: 0;
    transition: opacity 0.15s ease;
    font-family: var(--font-tag);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  :global(.legend-note) { font-size: 0.72rem; color: var(--stalk); margin-top: 0.6rem; display: flex; gap: 0.9rem; flex-wrap: wrap; }
  :global(.legend-note span) { display: inline-flex; align-items: center; gap: 0.3rem; }
  :global(.dash-sample) { display: inline-block; width: 14px; height: 0; border-top: 2px dashed var(--stalk); }

  :global(.empty) {
    color: var(--stalk);
    font-size: 0.88rem;
    text-align: center;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 130px;
  }

  .ballistics__glance,
  .ballistics__faq { margin-top: 2.5rem; max-width: 820px; }
  .ballistics__glance h2,
  .ballistics__faq h2 {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    margin: 0 0 0.9rem;
  }
  .ballistics__glance-note,
  .ballistics__faq p {
    line-height: 1.6;
    margin: 0 0 1.1rem;
  }
  .ballistics__table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--frost);
    border: 1px solid var(--stalk);
    border-top: 4px solid var(--blaze);
  }
  .ballistics__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 0.88rem;
  }
  .ballistics__table th,
  .ballistics__table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-top: 1px solid var(--stalk);
    white-space: nowrap;
  }
  .ballistics__table thead th {
    font-family: var(--font-tag);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--stalk);
    border-top: none;
  }
  .ballistics__table tbody th[scope='row'] {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }

  .ballistics__footer {
    margin-top: 1.75rem;
    font-size: 0.74rem;
    color: var(--stalk);
    line-height: 1.6;
    border-top: 1px solid var(--husk);
    padding-top: 0.9rem;
  }
</style>
