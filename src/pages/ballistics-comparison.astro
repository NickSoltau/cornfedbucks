---
import Layout from '../layouts/Layout.astro';
import FaqSchema from '../components/FaqSchema.astro';
import dataset from '../../public/data/ballistics-dataset.json';

const cartridgeCount = Object.keys(dataset).length;
const loadCount = Object.values(dataset).reduce((n, c) => n + c.loads.length, 0);

// Energies are the factory-published averages; drops are the calculated 100-yard-zero averages.
// Missing values (e.g. rimfire tables that stop at 100 yd) render as a dash.
const rows = Object.entries(dataset)
  .map(([name, c]) => {
    const pe = c.generic.published?.energy ?? {};
    const tr = c.generic.calculated?.trajectory ?? {};
    return {
      name,
      type: c.category,
      e100: pe['100'],
      e200: pe['200'],
      e300: pe['300'],
      d200: tr['200'] != null ? -tr['200'] : null,
      d300: tr['300'] != null ? -tr['300'] : null,
    };
  })
  .sort((a, b) => (b.e100 ?? -Infinity) - (a.e100 ?? -Infinity));
const dash = '\u2014';
const fmtE = (v) => (v == null ? dash : Math.round(v));
const fmtD = (v) => (v == null ? dash : v.toFixed(1));

const faqItems = [
  { question: "What does a 100-yard zero mean on this tool?", answer: "A zero is the distance where your rifle is sighted in to hit the point of aim. By default each load is shown as the factory printed it, on the factory table's own zero (often 100 or 200 yards, and the tooltip tells you which). Turn on \"Line up zeros (calculated)\" and every load is shown as if the rifle were zeroed at 100 yards, using the factory's 100-yard numbers where they exist and our calculation where they don't." },
  { question: "What does a dashed line mean?", answer: "A dashed segment is our calculation from the factory velocity table, not a number the manufacturer printed. A lighter dashed segment is a lower-confidence estimate, such as a slow straight-wall bullet or a point past 300 yards. Generic cartridge trajectory lines are always dashed because they are averages of calculated 100-yard-zero values." },
  { question: "Why are some loads greyed out?", answer: "No manufacturer table exists for them that we could find. We show them greyed out instead of guessing numbers. Right now every load in the tool has data, but we keep this in case any return." },
  { question: "Where does the data come from?", answer: "From manufacturers' published ballistics tables. One load is labeled ammo.com because Nosler doesn't publish a factory table for it, so that one is not factory data. The data was sourced in September and October 2026." },
];
---
<Layout
  title="Straight-Wall vs Shouldered Ballistics Tool"
  description="Compare energy, trajectory, and velocity across straight-wall and shouldered deer cartridges, up to four loads at once — most ag-field shots happen inside 200 yards, but it goes as far as the factory tables do."
>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.js" is:inline></script>

  <section class="ballistics">
    <div class="wrap">
      <header class="ballistics__header">
        <p class="eyebrow">Cornfed Bucks — Ballistics Lab</p>
        <h1>Ballistics Comparison Tool</h1>
        <p class="ballistics__intro">
          Pick up to four loads — any mix of straight-wall and shouldered cartridges — and see how
          they actually fly. Most ag-field shots happen inside 200 yards, but the tool goes as far as the factory tables do.
        </p>
        <p class="ballistics__intro ballistics__intro--summary">
          This tool compares energy, trajectory and velocity out to the last distance each factory table prints, for {cartridgeCount} cartridges and {loadCount} loads, from straight-wall rounds like the .350 Legend to shouldered rounds like the .308 Winchester. Want to know how the data was built? Read <a href="/blog/straight-wall-vs-shouldered-ballistics-comparison/">Straight-Wall vs Shouldered Ballistics</a>.
        </p>
        <p class="ballistics__updated">Data sourced Sept.–Oct. 2026 · Last updated: October 19, 2026</p>
        <div class="disclaimer">
          <b>Heads up:</b> by default every line is the manufacturer's own table, shown as printed. Factories
          don't all measure trajectory the same way — some zero at 100 yards, some at 200, and the yardage
          steps don't line up — so the zero each line is on is shown when you hover a point. Turn on
          "Line up zeros (calculated)" to put everything on a 100-yard zero; the parts we calculate are
          dashed. Nosler doesn't publish a table for one load, so it uses ammo.com's and is labeled that way.
        </div>
      </header>

      <div class="ballistics__controls">
        <label class="ballistics__toggle">
          <input type="checkbox" id="alignZeros" />
          <span>Line up zeros (calculated)</span>
        </label>
        <p class="ballistics__accuracy">
          Dashed lines are our calculation from the factory velocity table. Median error 0.02 in, 95th
          percentile 0.14 in through 300 yd. Past 300 yd, and on slow straight-wall bullets, treat them
          as estimates.
        </p>
      </div>

      <div class="layout">
        <div class="picker">
          <h2>Select loads</h2>
          <div class="slot-count" id="slotCount">0 / 4 selected</div>
          <div id="groups"></div>
        </div>

        <div id="heroSlot"></div>

        <div class="sidestack" id="sideSlot"></div>
      </div>

      <p class="ballistics__toolnote">
        Federal and Remington "Long Range" tables say 100 yd zero on the factory page, but the numbers
        match a 200 yd zero; we show them as printed. Federal, Remington and Nosler loads stop at
        300 yd for now.
      </p>

      <p class="ballistics__presets">
        <b>Head-to-heads:</b>
        <a href="/ballistics-comparison/?loads=.350%20Legend::GENERIC,.450%20Bushmaster::GENERIC">.350 Legend vs .450 Bushmaster</a> ·
        <a href="/ballistics-comparison/?loads=.308%20Winchester::GENERIC,6.5%20Creedmoor::GENERIC">.308 vs 6.5 Creedmoor</a> ·
        <a href="/ballistics-comparison/?loads=.300%20AAC%20Blackout::GENERIC,.300%20AAC%20Blackout%20Subsonic::GENERIC">.300 BLK supersonic vs subsonic</a>
      </p>

      <section class="ballistics__glance">
        <h2>Ballistics at a Glance: Generic Figures</h2>
        <p class="ballistics__glance-note">
          These are generic figures — the average of the loads for each cartridge — so individual
          loads vary. Energy is from factory tables; drop is our calculation on a 100-yard zero. Ranked by energy at 100&nbsp;yd, highest first.
        </p>
        <div class="ballistics__table-scroll">
          <table class="ballistics__table">
            <thead>
              <tr>
                <th scope="col">Cartridge</th>
                <th scope="col">Type</th>
                <th scope="col">Energy at 100 yd (ft-lbs)</th>
                <th scope="col">Energy at 200 yd</th>
                <th scope="col">Energy at 300 yd</th>
                <th scope="col">Drop at 200 yd (in)</th>
                <th scope="col">Drop at 300 yd (in)</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row">{r.name}</th>
                  <td>{r.type}</td>
                  <td>{fmtE(r.e100)}</td>
                  <td>{fmtE(r.e200)}</td>
                  <td>{fmtE(r.e300)}</td>
                  <td>{fmtD(r.d200)}</td>
                  <td>{fmtD(r.d300)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="ballistics__faq">
        <h2>FAQ: Ballistics Comparison</h2>
        {faqItems.map((qa) => (
          <p><strong>{qa.question}</strong><br />{qa.answer}</p>
        ))}
        <FaqSchema items={faqItems} />
      </section>

      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "CornfedBucks Ballistics Comparison Tool",
        url: "https://cornfedbucks.com/ballistics-comparison/",
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Any",
        isAccessibleForFree: true,
        dateModified: "2026-10-19",
        inLanguage: "en-US",
        author: { "@type": "Person", name: "Nick" },
        isPartOf: { "@type": "WebSite", name: "CornfedBucks", url: "https://cornfedbucks.com/" }
      })} />

      <footer class="ballistics__footer">
        Click any small chart on the right to swap it into the main view. Loads/legend are ranked by
        descending energy at 100&nbsp;yd (highest-hitting load listed first). Data: manufacturer-published
        ballistics tables, sourced Sept.&ndash;Oct. 2026, shown as printed. The one exception is labeled
        &ldquo;ammo.com&rdquo; (Nosler publishes no table for that load). Dashed segments are our
        calculation from the factory velocity table; lighter dashed segments are lower-confidence estimates.
        Loads tagged &ldquo;unverified&rdquo; have trajectory numbers we haven't yet re-checked against the
        factory page. Wind drift intentionally excluded — too situational to generalize.
      </footer>
    </div>
  </section>

  <script src="/scripts/ballistics-comparison.js" is:inline></script>
</Layout>

<style is:global>
  :root {
    --ballistics-line-a: var(--blaze);
    --ballistics-line-b: var(--dusk);
    --ballistics-line-c: #8a6d3a;
    --ballistics-line-d: var(--stalk);
    --ballistics-border: var(--stalk);
    --ballistics-surface: #ffffff;
    --ballistics-text: var(--ink);
    --ballistics-text-dim: var(--stalk);
  }
</style>

<style>
  .ballistics {
    padding: 3rem 0 4rem;
  }
  .ballistics__header { margin-bottom: 1.75rem; }
  .ballistics__header h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 0.4rem 0 0.9rem;
  }
  .ballistics__intro {
    color: var(--ink);
    opacity: 0.85;
    max-width: 66ch;
    line-height: 1.55;
    margin: 0;
  }

  .ballistics__intro--summary { margin-top: 0.75rem; }
  .ballistics__updated {
    font-size: 0.82rem;
    color: var(--stalk);
    margin: 0.6rem 0 0;
  }

  .disclaimer {
    background: #f4e3c8;
    border: 1px solid var(--husk);
    border-radius: 6px;
    padding: 0.9rem 1.1rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink);
    margin-top: 1.1rem;
  }
  .disclaimer b { color: var(--blaze); }

  .ballistics__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1rem;
  }
  .ballistics__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .ballistics__toggle input { accent-color: var(--blaze); width: 1rem; height: 1rem; }
  .ballistics__accuracy {
    flex: 1 1 320px;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--stalk);
    max-width: 70ch;
  }
  .ballistics__presets {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .ballistics__presets a { color: var(--blaze); }
  .ballistics__toolnote {
    margin: 1rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--stalk);
    max-width: 90ch;
  }

  .layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 320px;
    gap: 1.1rem;
    align-items: start;
  }
  @media (max-width: 1150px) {
    .layout { grid-template-columns: 240px minmax(0, 1fr); }
    :global(.sidestack) { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .layout { grid-template-columns: 1fr; }
    :global(.sidestack) { grid-column: auto; }
  }

  /* Below 1150px, #heroSlot/.sidestack no longer get a JS-set pixel height
     (see syncHeights() in ballistics-comparison.js), so the flex:1 / min-height:0
     sizing that fills a fixed-height parent on desktop collapses charts to 0px
     tall. Give chart holders a real fixed height instead. */
  @media (max-width: 1150px) {
    :global(#heroSlot .chartcard),
    :global(.sidestack .sidecard),
    :global(.sidestack .sidecard.pos0),
    :global(.sidestack .sidecard.pos1) {
      flex: none;
      min-height: auto;
    }
    :global(#heroSlot .chart-holder) {
      flex: none;
      height: 320px;
      min-height: 320px;
    }
    :global(.sidestack .chart-holder) {
      flex: none;
      height: 240px;
      min-height: 240px;
    }
    /* Without JS-driven heights below 1150px, the picker's natural height
       (15 collapsible cartridges) is often much taller than the chart next
       to it. align-items:start (above) stops that from stretching the chart
       cell, but the picker itself still needs a cap + internal scroll or it
       just pushes the page very long before the chart is reachable. */
    :global(.picker) {
      max-height: 60vh;
      overflow-y: auto;
    }
  }

  :global(.chart-holder) { position: relative; }

  /* Short / landscape-phone viewports (e.g. a phone rotated sideways) have
     very little vertical room — often under 430px total. Compact the header
     copy and chart heights so the actual tool is reachable without several
     screens of scrolling. Desktop and normal portrait-phone heights are
     untouched. */
  @media (max-height: 500px) {
    .ballistics { padding: 0.85rem 0 1.5rem; }
    .ballistics__header { margin-bottom: 0.85rem; }
    .ballistics__header .eyebrow { display: none; }
    .ballistics__header h1 {
      font-size: 1.3rem;
      margin: 0 0 0.4rem;
    }
    .ballistics__intro { display: none; }
    .disclaimer {
      padding: 0.5rem 0.7rem;
      font-size: 0.72rem;
      margin-top: 0.6rem;
    }
    :global(.picker) { max-height: 44vh; }
    :global(#heroSlot .chart-holder) { height: 200px; min-height: 200px; }
    :global(.sidestack .chart-holder) { height: 140px; min-height: 140px; }
  }

  :global(.picker) {
    background: #fff;
    border: 1px solid var(--stalk);
    border-radius: 8px;
    padding: 1rem;
    position: sticky;
    top: 1rem;
    overflow-y: auto;
  }
  /* Below 760px, .layout collapses to a single column (picker, hero chart,
     and sidestack all stacked in normal flow) — sticky then pins the picker
     to the top of the viewport while the charts scroll up underneath it,
     overlapping. Sticky only makes sense next to a taller side-by-side
     column, so drop it once the layout stops being side-by-side. */
  @media (max-width: 760px) {
    :global(.picker) { position: static; }
  }
  :global(#heroSlot) { display: flex; flex-direction: column; }
  :global(#heroSlot .chartcard) { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  :global(.picker h2) {
    font-size: 0.82rem;
    font-family: var(--font-tag);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--stalk);
    margin: 0 0 0.1rem;
  }
  :global(.slot-count) {
    font-family: var(--font-tag);
    font-size: 0.75rem;
    color: var(--blaze);
    margin-bottom: 0.75rem;
  }
  :global(.group) { margin-bottom: 0.4rem; border-bottom: 1px solid var(--husk); }
  :global(.group summary) {
    cursor: pointer;
    padding: 0.6rem 0.25rem;
    font-weight: 600;
    font-size: 0.92rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
  }
  :global(.group summary::-webkit-details-marker) { display: none; }
  :global(.group summary::after) { content: "+"; color: var(--stalk); font-weight: 400; }
  :global(.group[open] summary::after) { content: "\2013"; }
  :global(.group .cat) {
    font-size: 0.65rem;
    font-family: var(--font-tag);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--stalk);
    font-weight: 500;
  }
  :global(.loadlist) { padding: 0 0.15rem 0.6rem; display: flex; flex-direction: column; gap: 0.15rem; }
  :global(.loadrow) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: 5px;
    font-size: 0.82rem;
    cursor: pointer;
    line-height: 1.3;
  }
  :global(.loadrow:hover) { background: var(--frost); }
  :global(.loadrow input) { margin-top: 0.2rem; accent-color: var(--blaze); }
  :global(.loadrow .name) { color: var(--ink); }
  :global(.loadrow .meta) { color: var(--stalk); font-size: 0.72rem; }
  :global(.loadrow .tag) {
    display: inline-block;
    font-family: var(--font-tag);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0 0.3rem;
    border-radius: 3px;
    border: 1px solid var(--stalk);
    color: var(--stalk);
    vertical-align: 1px;
  }
  :global(.loadrow .tag--warn) { border-color: var(--blaze); color: var(--blaze); }
  :global(.loadrow.disabled) { opacity: 0.55; cursor: not-allowed; }
  :global(.loadrow.disabled .name) { text-decoration: line-through; color: var(--stalk); }
  :global(.loadrow.disabled:hover) { background: none; }
  :global(.loadrow.maxed:not(.checked)) { opacity: 0.4; cursor: not-allowed; }

  :global(.chartcard) {
    background: #fff;
    border: 1px solid var(--stalk);
    border-radius: 8px;
    padding: 1.1rem 1.1rem 0.75rem;
  }
  :global(.chartcard h3) {
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
  }
  :global(.chartcard .unit) {
    font-family: var(--font-tag);
    font-size: 0.72rem;
    color: var(--stalk);
    font-weight: 400;
  }

  :global(#heroSlot .chart-holder) { flex: 1; min-height: 280px; margin-top: 0.75rem; }
  :global(#heroSlot h3) { font-size: 1.15rem; }

  :global(.sidestack) { display: flex; flex-direction: column; gap: 0.9rem; }
  :global(.sidestack .chart-holder) { margin-top: 0.5rem; flex: 1; min-height: 130px; }
  :global(.sidestack .sidecard) {
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  :global(.sidestack .sidecard:hover) { border-color: var(--blaze); }
  :global(.sidestack .sidecard:hover .swap-hint) { opacity: 1; }
  :global(.sidestack .sidecard.pos0) { flex: 1.4; }
  :global(.sidestack .sidecard.pos0 h3) { font-size: 1.02rem; }
  :global(.sidestack .sidecard.pos1) { flex: 1; }
  :global(.sidestack h3) { font-size: 0.85rem; }
  :global(.sidestack .rank) {
    font-family: var(--font-tag);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.62rem;
    color: var(--blaze);
    font-weight: 600;
  }
  :global(.swap-hint) {
    margin-left: auto;
    font-size: 0.65rem;
    color: var(--stalk);
    opacity: 0;
    transition: opacity 0.15s ease;
    font-family: var(--font-tag);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  :global(.legend-note) { font-size: 0.72rem; color: var(--stalk); margin-top: 0.6rem; display: flex; gap: 0.9rem; flex-wrap: wrap; }
  :global(.legend-note span) { display: inline-flex; align-items: center; gap: 0.3rem; }
  :global(.dash-sample) { display: inline-block; width: 14px; height: 0; border-top: 2px dashed var(--stalk); }

  :global(.empty) {
    color: var(--stalk);
    font-size: 0.88rem;
    text-align: center;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 130px;
  }

  .ballistics__glance,
  .ballistics__faq { margin-top: 2.5rem; max-width: 820px; }
  .ballistics__glance h2,
  .ballistics__faq h2 {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    margin: 0 0 0.9rem;
  }
  .ballistics__glance-note,
  .ballistics__faq p {
    line-height: 1.6;
    margin: 0 0 1.1rem;
  }
  .ballistics__table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--frost);
    border: 1px solid var(--stalk);
    border-top: 4px solid var(--blaze);
  }
  .ballistics__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 0.88rem;
  }
  .ballistics__table th,
  .ballistics__table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-top: 1px solid var(--stalk);
    white-space: nowrap;
  }
  .ballistics__table thead th {
    font-family: var(--font-tag);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--stalk);
    border-top: none;
  }
  .ballistics__table tbody th[scope='row'] {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }

  .ballistics__footer {
    margin-top: 1.75rem;
    font-size: 0.74rem;
    color: var(--stalk);
    line-height: 1.6;
    border-top: 1px solid var(--husk);
    padding-top: 0.9rem;
  }
</style>
