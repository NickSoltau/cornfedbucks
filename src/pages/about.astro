---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About" description="What Cornfed Bucks is and who it's for.">
  <section class="about">
    <div class="wrap about__inner">
      <p class="eyebrow">About</p>
      <h1>Hunting between the rows.</h1>
      <p>
        Most whitetail content is written for big timber — mountain benches, river-bottom hardwoods,
        thousand-acre public tracts. That's not the hunting most of us in corn and bean country actually do.
      </p>
      <p>
        Cornfed Bucks is for hunters working real Midwest ag ground: a leased 80, a family farm,
        a fence line between two fields that's the only cover for half a mile. The strategy here
        starts from that reality — edges instead of interiors, combine schedules instead of just
        moon phases, and small sanctuary acres instead of big food plot budgets.
      </p>
      <p>
        New field notes go up through the season, and the Monday Morning Report newsletter covers
        what changed in the woods — and in the fields — over the past week.
      </p>
    </div>
  </section>

  <section class="books">
    <div class="wrap books__inner">
      <p class="eyebrow">Guides</p>
      <h2>Take it with you to the field.</h2>
      <p class="books__intro">
        Two companion guides, built around the same small-acreage, row-crop-timing approach as the
        field notes — available in print and on Kindle.
      </p>
      <div class="books__grid">
        <a class="book-card" href="https://link.amazon/B03KhoZDf" rel="sponsored noopener" target="_blank">
          <picture class="book-card__cover">
            <source srcset="/images/perfect-window-cover.webp" type="image/webp" />
            <img src="/images/perfect-window-cover.jpg" alt="The Perfect Window book cover" width="500" height="647" loading="lazy" />
          </picture>
          <div class="book-card__body">
            <p class="book-card__title">The Perfect Window</p>
            <p class="book-card__sub">2026&ndash;27 Season &amp; Rut Calendar</p>
            <p class="book-card__desc">
              Harvest timing, rut windows, and legal season dates across all 12 Corn Belt states, laid
              out on one visual overlap chart.
            </p>
            <span class="book-card__cta">Get it on Amazon &rarr;</span>
          </div>
        </a>
        <a class="book-card" href="https://link.amazon/B0epGKYi9" rel="sponsored noopener" target="_blank">
          <picture class="book-card__cover">
            <source srcset="/images/effective-window-cover.webp" type="image/webp" />
            <img src="/images/effective-window-cover.jpg" alt="The Effective Window book cover" width="500" height="647" loading="lazy" />
          </picture>
          <div class="book-card__body">
            <p class="book-card__title">The Effective Window</p>
            <p class="book-card__sub">Food Plot &amp; Stand Timing Guide</p>
            <p class="book-card__desc">
              For small acreage surrounded by corn and soybeans — siting, timing, and stand placement
              built around the neighboring field's harvest, not against it.
            </p>
            <span class="book-card__cta">Get it on Amazon &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about { padding: 3.5rem 0 5rem; }
  .about__inner { max-width: 620px; }
  .about h1 {
    font-size: clamp(2rem, 4vw, 2.6rem);
    margin-top: 0.5rem;
  }
  .about p {
    margin: 0 0 1.2rem;
    font-size: 1.02rem;
  }

  .books {
    background: var(--husk);
    padding: 3rem 0 3.5rem;
  }
  .books__inner { max-width: 780px; }
  .books h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin: 0.4rem 0 0.75rem;
  }
  .books__intro {
    margin: 0 0 1.75rem;
    max-width: 56ch;
    font-size: 1rem;
  }
  .books__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .book-card {
    display: flex;
    gap: 1.25rem;
    background: var(--frost);
    border: 1px solid var(--stalk);
    border-radius: 6px;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .book-card:hover {
    border-color: var(--blaze);
    transform: translateY(-2px);
  }
  .book-card__cover {
    flex: 0 0 auto;
    width: 108px;
  }
  .book-card__cover img {
    width: 100%;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 4px 14px rgba(34, 27, 20, 0.25);
  }
  .book-card__body { min-width: 0; }
  .book-card__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
  }
  .book-card__sub {
    font-family: var(--font-tag);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--stalk);
    margin: 0 0 0.85rem;
  }
  .book-card__desc {
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0 0 1.1rem;
  }
  .book-card__cta {
    font-family: var(--font-tag);
    font-size: 0.8rem;
    color: var(--blaze);
  }

  @media (max-width: 420px) {
    .book-card { flex-direction: column; }
    .book-card__cover { width: 120px; }
  }
</style>
